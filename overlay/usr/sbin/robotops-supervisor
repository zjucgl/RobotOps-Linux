#!/bin/sh
set -u

DEFAULTS=/etc/default/robotops
[ -r "$DEFAULTS" ] && . "$DEFAULTS"

: "${ROBOTOPS_APP_DIR:=/opt/robotops/robotops-client}"
: "${ROBOTOPS_CONFIG:=/etc/robotops/gateway.json}"
: "${ROBOTOPS_STATE_DIR:=/opt/robotops/state}"
: "${ROBOTOPS_LOG_FILE:=/var/log/robotops-client.log}"
: "${ROBOTOPS_HEARTBEAT_INTERVAL:=60}"
: "${ROBOTOPS_QUEUE_MAX_MIB:=8}"
: "${ROBOTOPS_RESTART_DELAY:=5}"
: "${ROBOTOPS_NTP_SERVERS:=pool.ntp.org}"
: "${ROBOTOPS_WIRED_IFACE:=eth0}"
: "${ROBOTOPS_REQUIRE_DEFAULT_ROUTE:=1}"
: "${ROBOTOPS_UPLINK_MODE:=any}"

child_pid=

stop_child() {
    if [ -n "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null; then
        kill "$child_pid" 2>/dev/null || true
        wait "$child_pid" 2>/dev/null || true
    fi
    exit 0
}

trap stop_child INT TERM

log() {
    logger -t robotops-supervisor "$*" 2>/dev/null || echo "$*" >/dev/console
}

clock_is_valid() {
    [ "$(date +%s)" -ge 1704067200 ]
}

sync_clock() {
    command -v ntpd >/dev/null 2>&1 || return 1
    for server in $ROBOTOPS_NTP_SERVERS; do
        ntpd -q -p "$server" >/dev/null 2>&1 && return 0
    done
    return 1
}

network_is_ready() {
    if [ "$ROBOTOPS_UPLINK_MODE" = "wired" ]; then
        ip -4 addr show dev "$ROBOTOPS_WIRED_IFACE" 2>/dev/null | grep -q 'inet ' || return 1
    else
        ip -4 addr show scope global 2>/dev/null | grep -q 'inet ' || return 1
    fi
    if [ "$ROBOTOPS_REQUIRE_DEFAULT_ROUTE" = "1" ]; then
        if [ "$ROBOTOPS_UPLINK_MODE" = "wired" ]; then
            ip route show default 2>/dev/null | grep -q "dev $ROBOTOPS_WIRED_IFACE"
        else
            ip route show default 2>/dev/null | grep -q '^default'
        fi
    fi
}

wired_dhcp_is_running() {
    ps w 2>/dev/null | grep '[u]dhcpc' | grep -q -- "-i $ROBOTOPS_WIRED_IFACE"
}

ensure_wired_dhcp() {
    ip link set "$ROBOTOPS_WIRED_IFACE" up 2>/dev/null || return 1
    wired_dhcp_is_running && return 0
    udhcpc -b -i "$ROBOTOPS_WIRED_IFACE" \
        -p "/run/udhcpc-$ROBOTOPS_WIRED_IFACE.pid" \
        -s /usr/share/udhcpc/default.script >/dev/null 2>&1 &
}

mkdir -p "$ROBOTOPS_STATE_DIR" "$(dirname "$ROBOTOPS_LOG_FILE")"

while ! network_is_ready; do
    log "waiting for an uplink; checking wired DHCP on $ROBOTOPS_WIRED_IFACE"
    ensure_wired_dhcp || true
    sleep 5
done

while ! clock_is_valid; do
    log "waiting for a valid system clock"
    sync_clock || true
    sleep 10
done

while [ ! -r "$ROBOTOPS_CONFIG" ]; do
    log "waiting for configuration: $ROBOTOPS_CONFIG"
    sleep 10
done

export PYTHONPATH="$ROBOTOPS_APP_DIR/vendor:$ROBOTOPS_APP_DIR"

while :; do
    cd "$ROBOTOPS_APP_DIR" || exit 1
    /usr/bin/python3 -u -m gateway.main \
        --config "$ROBOTOPS_CONFIG" \
        --state-dir "$ROBOTOPS_STATE_DIR" \
        --heartbeat-interval "$ROBOTOPS_HEARTBEAT_INTERVAL" \
        --queue-max-mib "$ROBOTOPS_QUEUE_MAX_MIB" \
        >>"$ROBOTOPS_LOG_FILE" 2>&1 &
    child_pid=$!
    wait "$child_pid"
    status=$?
    child_pid=
    log "robotops-client exited with status $status; restarting"
    sleep "$ROBOTOPS_RESTART_DELAY"
done
